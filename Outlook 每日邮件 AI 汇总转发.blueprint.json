{
    "name": "Outlook 每日邮件 AI 汇总转发",
    "flow": [
        {
            "id": 3,
            "module": "microsoft-email:listMessages",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 10410404
            },
            "mapper": {
                "limit": "100",
                "folder": "/AQMkADAwATMwMAExLWFjODEtNjYAZDItMDACLTAwCgAuAAADu8YRJFYqkEu4MdIwZ2bWlAEAdIcaDLXLGECCZSVmO311GQAAAgEMAAAA",
                "search": "received:yesterday OR received:today",
                "orderby": "receivedDateTime asc"
            },
            "metadata": {
                "designer": {
                    "x": 587,
                    "y": -88,
                    "name": "取今天邮件"
                },
                "restore": {
                    "expect": {
                        "folder": {
                            "mode": "chose",
                            "path": [
                                "收件箱"
                            ]
                        },
                        "orderby": {
                            "mode": "chose",
                            "label": "Received Date Time - Ascending"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "azure"
                            },
                            "label": "generated"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:azure",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "folder",
                        "type": "folder",
                        "label": "Mail Folder"
                    },
                    {
                        "name": "search",
                        "type": "text",
                        "label": "Search"
                    },
                    {
                        "name": "orderby",
                        "type": "select",
                        "label": "Order by",
                        "validate": {
                            "enum": [
                                "subject asc",
                                "subject desc",
                                "createdDateTime asc",
                                "createdDateTime desc",
                                "lastModifiedDateTime asc",
                                "lastModifiedDateTime desc",
                                "receivedDateTime asc",
                                "receivedDateTime desc"
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "type": "uinteger",
                        "label": "Limit"
                    }
                ]
            }
        },
        {
            "id": 4,
            "module": "util:TextAggregator",
            "version": 1,
            "parameters": {
                "feeder": 3,
                "rowSeparator": "other",
                "otherRowSeparator": "================"
            },
            "filter": {
                "name": "取出昨天晚上九点到今天中午1点的邮件",
                "conditions": [
                    [
                        {
                            "a": "{{3.receivedDateTime}}",
                            "b": "{{addHours(parseDate(formatDate(addDays(now; -1); \"YYYY-MM-DD\"; \"Asia/Shanghai\"); \"YYYY-MM-DD\"; \"Asia/Shanghai\"); 21)}}",
                            "o": "date:greaterorequal"
                        },
                        {
                            "a": "{{3.receivedDateTime}}",
                            "b": "{{addHours(parseDate(formatDate(now; \"YYYY-MM-DD\"; \"Asia/Shanghai\"); \"YYYY-MM-DD\"; \"Asia/Shanghai\"); 13)}}",
                            "o": "date:less"
                        }
                    ]
                ]
            },
            "mapper": {
                "value": "主题：{{3.subject}}\n内容：{{ifempty(stripHTML(3.body.content); 3.bodyPreview)}}\n链接：{{3.webLink}}"
            },
            "metadata": {
                "designer": {
                    "x": 936,
                    "y": -94,
                    "name": "汇总成文本"
                },
                "restore": {
                    "parameters": {
                        "rowSeparator": {
                            "mode": "chose",
                            "label": "Other",
                            "nested": [
                                {
                                    "name": "otherRowSeparator",
                                    "type": "text",
                                    "label": "Separator"
                                }
                            ]
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "rowSeparator",
                        "type": "select",
                        "label": "Row separator",
                        "advanced": true,
                        "required": false,
                        "validate": {
                            "enum": [
                                "\n",
                                "\t",
                                "other"
                            ]
                        }
                    },
                    {
                        "name": "otherRowSeparator",
                        "type": "text",
                        "label": "Separator"
                    }
                ],
                "expect": [
                    {
                        "name": "value",
                        "type": "text",
                        "label": "Text"
                    }
                ]
            },
            "flags": {
                "stopIfEmpty": true
            }
        },
        {
            "id": 12,
            "module": "deepseek-ai:createAChatCompletion",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 10412564
            },
            "mapper": {
                "model": "deepseek-v4-flash",
                "top_p": "1",
                "messages": [
                    {
                        "role": "user",
                        "content": "你是一名邮件助理。请基于下面“今日邮件汇总原文”，用中文输出,输出用html格式排列好，要美观，简单html即可，之后你的输出会直接作为正文发送：\r\n\n- 如存在重要细节，则增加独立的信息区域，列出：\r\n  - 📅 日期与时间\r\n  - 📍 地点或会议方式\r\n  - 👤 主讲人、联系人或相关人员\r\n  - 🗣️ 使用语言\r\n  - 🎟️ 报名方式、截止日期或参加条件\r\n  - 🔗 相关链接\r\n  - 📎 附件情况\n\n【颜色与视觉层级】\r\n\r\n颜色不必固定，可根据邮件类别自动选择，但整体应保持克制、统一且易读。例如：\r\n\r\n- 活动：蓝色\n- 讲座：紫色\r\n- 工作或课程待办：橙色 \n- 成功、确认：绿色\r\n- 安全通知：深灰色\r\n- 重要邮件：红色\n\r\n不同类型可通过卡片左侧彩色边框和浅色背景进行区分\r\n\r\n今日邮件汇总原文：\r\n{{4.text}}\n\n\n【推荐 HTML 框架】\r\n\r\n<!DOCTYPE html>\r\n<html lang=\"zh\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>{{汇总标题}}</title>\r\n</head>\r\n<body style=\"font-family: Arial, 'Microsoft YaHei', sans-serif; background-color: #f5f5f5; margin: 0; padding: 20px; color: #333;\">\r\n    <div style=\"max-width: 800px; margin: 0 auto; background: #ffffff; padding: 30px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);\">\r\n        \r\n        <h1 style=\"color: {{主题色}}; border-bottom: 3px solid {{主题色}}; padding-bottom: 10px; margin-top: 0; font-size: 1.6em;\">\r\n            📋 {{汇总标题}}\r\n        </h1>\r\n\r\n        <p style=\"color: #888; font-size: 13px;\">\r\n            共 {{邮件数量}} 封邮件 | 汇总日期：{{日期}}\r\n        </p>\r\n\r\n        <!-- 按邮件数量重复以下卡片 -->\r\n        <div style=\"margin-bottom: 25px; padding: 15px; background: {{分类浅色背景}}; border-left: 4px solid {{分类强调色}}; border-radius: 4px;\">\r\n            <h2 style=\"font-size: 1.15em; margin: 0 0 7px; color: #333;\">\r\n                {{序号表情}} {{概括后的邮件标题}}\r\n            </h2>\r\n\r\n            <p style=\"margin: 4px 0; color: #555;\">\r\n                <strong>发件人：</strong>{{发件人}}\r\n            </p>\r\n\r\n            <p style=\"margin: 4px 0; color: #555;\">\r\n                <strong>类别：</strong>{{邮件类别}}\r\n            </p>\r\n\r\n            <p style=\"margin: 8px 0; color: #555; line-height: 1.6;\">\r\n                {{核心内容摘要}}\r\n            </p>\r\n\r\n            <!-- 仅在存在具体信息时显示 -->\r\n            <div style=\"margin-top: 10px; padding: 7px 10px; border-left: 2px solid #ccc;\">\r\n                <p style=\"margin: 3px 0; font-size: 14px;\">\r\n                    <strong>📅 时间：</strong>{{时间}}\r\n                </p>\r\n                <p style=\"margin: 3px 0; font-size: 14px;\">\r\n                    <strong>📍 地点：</strong>{{地点}}\r\n                </p>\r\n                <p style=\"margin: 3px 0; font-size: 14px;\">\r\n                    <strong>👤 相关人员：</strong>{{人员信息}}\r\n                </p>\r\n                <p style=\"margin: 3px 0; font-size: 14px;\">\r\n                    <strong>🎟️ 参加方式：</strong>{{报名或参加要求}}\r\n                </p>\r\n            </div>\r\n\r\n            <!-- 仅在用户需要采取行动时显示 -->\r\n            <div style=\"margin-top: 10px; background: {{提示背景色}}; padding: 9px 12px; border-radius: 4px; font-size: 14px;\">\r\n                <p style=\"margin: 3px 0;\">\r\n                    <strong>📌 建议操作：</strong>{{用户需要采取的行动}}\r\n                </p>\r\n            </div>\r\n        </div>"
                    }
                ],
                "thinking": true,
                "max_tokens": "309600",
                "temperature": "1",
                "response_format": {
                    "type": "text"
                },
                "reasoning_effort": "high"
            },
            "metadata": {
                "designer": {
                    "x": 1251,
                    "y": -99
                },
                "restore": {
                    "expect": {
                        "stop": {
                            "mode": "chose"
